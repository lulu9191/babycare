.detail-row{display:flex;justify-content:space-between;gap:28rpx;padding:20rpx 0;border-bottom:1rpx solid #e4e9e1}.detail-block{padding-top:24rpx;white-space:pre-wrap;overflow-wrap:anywhere}.detail-block .muted{margin-bottom:8rpx}.tags{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:20rpx}.record-link{display:block;background:transparent;text-align:left;line-height:1.7;font-size:28rpx;padding:22rpx 0;border-bottom:1rpx solid #e4e9e1;border-radius:0;margin:0}.record-link:last-child{border-bottom:0}.record-link::after{border:0}.medication-row{padding:24rpx 0;border-bottom:1rpx solid #e4e9e1}.medication-row:last-child{border-bottom:0}.medication-name{font-size:30rpx;font-weight:600}.usage{margin-top:12rpx}.primary{margin-top:28rpx}.secondary{margin-top:16rpx}
