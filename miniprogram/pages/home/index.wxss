.people-row { display:flex; flex-wrap:wrap; gap:16rpx; margin:24rpx 0 36rpx; }
.person-chip { display:flex; align-items:center; gap:12rpx; padding:8rpx 24rpx 8rpx 8rpx; margin:0; }
.avatar { width:60rpx; height:60rpx; border-radius:50%; flex-shrink:0; }
.fallback { display:flex; justify-content:center; align-items:center; background:#e8f0e6; color:#35664e; }
.add-person { width:76rpx; height:76rpx; line-height:72rpx; margin:0; border:1rpx dashed #b6c7bb; border-radius:50%; background:transparent; color:#35664e; padding:0; }
.periods { display:flex; gap:12rpx; margin-top:28rpx; }
.period { padding:0 24rpx; min-height:76rpx; line-height:76rpx; font-size:24rpx; color:#607268; background:#fff; border-radius:40rpx; margin:0; }
.period.selected { background:#35664e; color:#fff; }
.range { margin:16rpx 0 24rpx; }
.metrics { display:flex; padding:28rpx 0; }
.metric { flex:1; display:flex; flex-direction:column; align-items:center; gap:8rpx; }
.metric + .metric { border-left:1rpx solid #e4e9e1; }
.number { font-size:52rpx; font-weight:600; }
.upload-button { margin-top:32rpx; }
.upload-caption { text-align:center; margin:12rpx 0 32rpx; }
.section-heading { margin-top:24rpx; }
.text-button { padding:12rpx 0; margin:0; font-size:26rpx; color:#35664e; background:transparent; }
.text-button::after, .visit-card::after, .period::after, .add-person::after { border:0; }
.visit-card { width:100%; text-align:left; line-height:1.6; color:#263c32; }
.visit-title { font-size:30rpx; font-weight:600; margin:12rpx 0; }
.complaint { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.tags { display:flex; gap:8rpx; flex-wrap:wrap; margin-top:16rpx; }
