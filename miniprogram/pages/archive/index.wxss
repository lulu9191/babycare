.people-row { display:flex; flex-wrap:wrap; gap:12rpx; margin:24rpx 0 32rpx; }
.person-chip { display:flex; align-items:center; gap:12rpx; margin:0; }
.initial { display:inline-flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; border-radius:50%; background:#e8f0e6; color:#35664e; }
.search { margin-top:28rpx; }
.filters { display:flex; flex-wrap:wrap; gap:16rpx; }
.filter { width:calc((100% - 16rpx) / 2); min-width:0; }
.picker { display:flex; align-items:center; justify-content:space-between; gap:8rpx; min-height:88rpx; }
.shortcuts { display:flex; flex-wrap:wrap; gap:12rpx; margin:24rpx 0; }
.quick { border-radius:36rpx; background:#fff; color:#35664e; font-size:24rpx; margin:0; padding:12rpx 20rpx; line-height:1.8; min-height:76rpx; }
.quick::after, .visit-card::after { border:0; }
.range, .search-note { margin-top:12rpx; }
.result-count { margin:28rpx 0 16rpx; }
.visit-card { width:100%; text-align:left; line-height:1.6; color:#263c32; }
.visit-title { font-size:30rpx; font-weight:600; margin:12rpx 0; }
.tags { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:16rpx; }
@media (max-width:340px) { .filter { width:100%; } }
