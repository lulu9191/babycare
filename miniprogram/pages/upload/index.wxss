.kind-row,.pair,.file-actions{display:flex;gap:16rpx;flex-wrap:wrap}.kind{margin:0;flex:1;padding:12rpx 6rpx;font-size:24rpx;line-height:1.6;background:#f7f8f4;color:#607268;border:2rpx solid #e4e9e1;border-radius:20rpx;min-height:76rpx}.kind.selected{background:#e8f0e6;color:#35664e;border-color:#35664e}.file-row{display:flex;align-items:center;gap:12rpx;border-bottom:1rpx solid #e4e9e1;padding:12rpx 0}.file-name{flex:1;text-align:left;background:transparent;font-size:26rpx;padding:10rpx 0;line-height:1.5;overflow-wrap:anywhere}.file-name::after,.remove::after{border:0}.remove{margin:0;padding:10rpx 16rpx;min-height:72rpx;line-height:1.5;font-size:24rpx;color:#607268;background:transparent}.file-actions{margin-top:20rpx}.file-actions button{flex:1;min-width:200rpx}.date-row{display:flex;align-items:center;gap:12rpx}.date-row picker{flex:1}.textarea{box-sizing:border-box;min-height:120rpx;width:100%;padding:18rpx}.pair .field{flex:1;min-width:180rpx}.item-editor{border-top:1rpx solid #e4e9e1;margin-top:28rpx;padding-top:20rpx}.error{color:#8e382e;background:#fff0eb}.field{margin-top:24rpx}.input{margin-top:10rpx}.primary,.secondary{margin-top:20rpx}
