.file-link{display:block;text-align:left;background:transparent;line-height:1.7;font-size:28rpx;padding:20rpx 0;border-bottom:1rpx solid #e4e9e1;border-radius:0;margin:0}.file-link::after{border:0}.file-link:last-child{border:0}.detail-row{display:flex;justify-content:space-between;gap:24rpx;padding:20rpx 0;border-bottom:1rpx solid #e4e9e1}.detail-block{padding-top:22rpx;white-space:pre-wrap;overflow-wrap:anywhere}.detail-block .muted{margin-bottom:8rpx}.lab-item{border-top:1rpx solid #e4e9e1;padding:24rpx 0;margin-top:12rpx}.lab-value{margin:8rpx 0}.badge{margin-left:10rpx}.primary,.secondary{margin-top:24rpx}.input{margin:12rpx 0}.field{margin-top:22rpx}
