.page-title { margin-top:32rpx; }
.avatar-button { display:flex; align-items:center; flex-direction:column; gap:16rpx; width:240rpx; padding:28rpx 0; margin:24rpx auto; background:transparent; font-size:26rpx; line-height:1.6; color:#35664e; }
.avatar-button::after, .text-button::after { border:0; }
.avatar-large { width:144rpx; height:144rpx; border-radius:50%; }
.fallback { display:flex; align-items:center; justify-content:center; background:#e8f0e6; font-size:54rpx; }
.birthday-label { margin-top:24rpx; align-items:center; }
.text-button { margin:0; padding:10rpx 0; min-height:76rpx; color:#35664e; background:transparent; font-size:26rpx; }
.date-picker { display:flex; justify-content:space-between; align-items:center; }
.help { margin-top:20rpx; line-height:1.7; }
.save-button { margin-top:32rpx; }
